# Copy this file to ".env" and fill in your real values.
# The real .env file is ignored by Git - NEVER commit it or share your key.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Any model ID your key can use (see https://console.groq.com/docs/models,
# or type /models inside the chatbot). If you leave this out, the app uses openai/gpt-oss-20b.
# Note: llama-3.1-8b-instant (from the assignment) was retired by Groq on 2026-08-16.
MODEL_NAME=openai/gpt-oss-20b

# Optional: how many recent messages are sent to the model each turn (default 40).
# MAX_HISTORY_MESSAGES=40

# Web dashboard (Google OAuth is optional for local preview).
# Create a Google OAuth web client and add this exact redirect URI:
# http://127.0.0.1:8000/auth/google/callback
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# NOVA_SESSION_SECRET=generate_a_long_random_secret
# NOVA_LOCAL_PREVIEW=true
# NOVA_ALLOW_ANONYMOUS=true
# NOVA_BASE_URL=http://127.0.0.1:8000
# On a host with a persistent disk, point this at the mounted disk location.
# NOVA_DB_PATH=/var/data/chats.sqlite3
